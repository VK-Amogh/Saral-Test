# ==============================================================================
# Saral AI — Production & Development Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development or configure these variables in
# Render / Cloud environment secret managers for production deployment.
#
# SECURITY NOTICE:
# - NEVER commit real credentials, service keys, or private tokens to Git.
# - SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY must NEVER be given to the Flutter app.
# - OTP and CAPTCHA values are ephemeral in-memory relays and must never be stored.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Server Environment
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'test', or 'production'
APP_ENV=production

# Logging verbosity: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
# CAUTION: Never set LOG_LEVEL to DEBUG in production. All logs pass through the RedactingLogFilter.
LOG_LEVEL=INFO

# Network binding
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Configuration (Auth, Postgres, Storage, Realtime)
# ------------------------------------------------------------------------------
# Supabase project REST URL
# Example: https://rsftbslckmdkynprmpin.supabase.co
SUPABASE_URL=https://rsftbslckmdkynprmpin.supabase.co

# Supabase Project ID / Reference
SUPABASE_PROJECT_ID=rsftbslckmdkynprmpin

# Supabase Publishable Key (safe for mobile client and web applications)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_6Bkn_iWd2OHLapk1e4D_TA_iTDffnJZ

# Supabase Service Role Secret Key (BACKEND AND WORKER ONLY — Full RLS bypass)
# DO NOT expose this key to the Flutter mobile app or frontend builds!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJzZnRic2xja21ka3lucHJtcGluIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTg2MTkwNywiZXhwIjoyMTA3NDM3OTA3fQ.-EHh9KtozB_F-zO9uZz5AP8Zw9Up7ijiTPObY8JYdKs
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJzZnRic2xja21ka3lucHJtcGluIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTg2MTkwNywiZXhwIjoyMTA3NDM3OTA3fQ.-EHh9KtozB_F-zO9uZz5AP8Zw9Up7ijiTPObY8JYdKs

# Supabase JWT Secret (from Supabase Dashboard -> Project Settings -> API -> JWT Settings)
# Used for offline cryptographic verification of incoming bearer tokens.
SUPABASE_JWT_SECRET=super_secret_supabase_jwt_signing_key_at_least_32_characters

# Direct PostgreSQL Connection URL (used for FOR UPDATE SKIP LOCKED job queue pooling)
# Format: postgresql://postgres.[project_ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.rsftbslckmdkynprmpin:YourDatabasePasswordHere@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Private Supabase Storage bucket for verified citizen downloads
STORAGE_BUCKET=documents

# ------------------------------------------------------------------------------
# 3. AI & Large Language Model Providers
# ------------------------------------------------------------------------------
# Primary Chat LLM Provider: Groq Cloud API
GROQ_API_KEY=gsk_mock_saral_groq_api_key_for_testing

# Default conversational & intent classification model
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Secondary / Fallback LLM Provider: Google Gemini (optional)
GEMINI_API_KEY=AIzaSyExampleKeyFromGoogleAIStudio
GEMINI_MODEL=gemini-1.5-flash

# Structured Decisions & Intent Routing: TypeSafe Jev (optional)
# Model version must be pinned for deterministic behavior
TYPESAFE_API_KEY=ts_api_key_from_console_typesafe_ai
JEV_MODEL=jev-1.13.0

# ------------------------------------------------------------------------------
# 4. Internal Inter-Service Security Secrets
# ------------------------------------------------------------------------------
# Shared secret for authenticating the Playwright worker WebSocket connection (/internal/worker)
WORKER_SHARED_SECRET=saral_worker_shared_secret_secure_key_9988
WORKER_SECRET=saral_worker_shared_secret_secure_key_9988

# Secret token for authenticating the scheduled hourly cleanup cron (/internal/cleanup)
# Transmitted via 'X-Cleanup-Secret' header
CLEANUP_SECRET=saral_cleanup_cron_secret_auth_token_7766

# ------------------------------------------------------------------------------
# 5. Security Policies & Route Allowlisting
# ------------------------------------------------------------------------------
# Strict domain allowlist for Playwright browser automation contexts (comma-separated).
# Any network request outside these domains is immediately aborted with route-level blocking.
ALLOWED_DOMAINS=mock-portal.local,127.0.0.1,localhost,saral-mock-portal.onrender.com,uidai.gov.in,myaadhaar.uidai.gov.in

# ------------------------------------------------------------------------------
# 6. Rate Limiting & Protection
# ------------------------------------------------------------------------------
# Per-user slowapi rate limits
CHAT_RATE_LIMIT=30/minute
INPUT_RATE_LIMIT=10/minute

# ------------------------------------------------------------------------------
# 7. Document Retention & Verifier Thresholds
# ------------------------------------------------------------------------------
# Default document lifetime before automatic purge (hours)
DEFAULT_RETENTION_HOURS=24

# Maximum allowed citizen retention in document vault (days)
MAX_RETENTION_DAYS=30

# Verifier document payload size limits (5 MB maximum)
MIN_FILE_SIZE_BYTES=10240
MAX_FILE_SIZE_BYTES=5242880

# ------------------------------------------------------------------------------
# 8. Browser Automation Worker Settings (Playwright)
# ------------------------------------------------------------------------------
# Run browser worker headlessly
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium

# Timeout configurations in milliseconds
BROWSER_TIMEOUT_MS=30000
PAGE_TIMEOUT_MS=15000
CHALLENGE_TIMEOUT_SECONDS=180

# WebSocket target for worker to connect back to the API server
WORKER_BACKEND_WS_URL=ws://127.0.0.1:8000/internal/worker

# ------------------------------------------------------------------------------
# 9. Mock Government Portal Configuration
# ------------------------------------------------------------------------------
MOCK_PORTAL_HOST=127.0.0.1
MOCK_PORTAL_PORT=8001
MOCK_PORTAL_URL=http://127.0.0.1:8001

# ------------------------------------------------------------------------------
# 10. Flutter Mobile Client Compilation Flags (env.json / --dart-define)
# ------------------------------------------------------------------------------
# For Flutter compilation, pass these via:
# flutter run --dart-define-from-file=env.json
# or pass individually with --dart-define=KEY=VALUE:
#
# API_BASE_URL=https://saral-backend.onrender.com
# SUPABASE_URL=https://rsftbslckmdkynprmpin.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_6Bkn_iWd2OHLapk1e4D_TA_iTDffnJZ
